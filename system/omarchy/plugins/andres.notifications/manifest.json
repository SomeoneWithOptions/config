{
  "schemaVersion": 1,
  "id": "andres.notifications",
  "name": "My Notifications",
  "version": "1.0.0",
  "author": "Omarchy",
  "description": "Notification daemon, popups, DND, and history",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Do Not Disturb",
    "description": "Shows when notifications are silenced",
    "category": "Status",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "omarchy": {
    "clonedFrom": "omarchy.notifications"
  }
}
