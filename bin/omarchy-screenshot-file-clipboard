#!/usr/bin/env bash
set -euo pipefail

# Take an Omarchy screenshot, then put the saved PNG on the clipboard as a file
# object, matching the practical behavior of copying an image from GNOME Files.

mode="${1:-smart}"
case "$mode" in
  smart|region|windows|fullscreen)
    shift || true
    ;;
  *)
    mode="smart"
    ;;
esac

capture_path="$PATH"
if command -v quickshell >/dev/null 2>&1 \
  && [[ -x "$HOME/.local/lib/flicko-picker/slurp" ]] \
  && [[ -f "$HOME/.config/quickshell/flicko-picker/shell.qml" ]]; then
  capture_path="$HOME/.local/lib/flicko-picker:$capture_path"
fi

filepath="$(PATH="$capture_path" omarchy-capture-screenshot "$mode" save "$@" | tail -n 1)"
[[ -n "$filepath" && -f "$filepath" ]] || exit 0

clipboard_helper="$HOME/.local/bin/copy-file-to-clipboard"
if [[ -x "$clipboard_helper" ]]; then
  setsid -f "$clipboard_helper" "$filepath" >/dev/null 2>&1
else
  # Minimal fallback: GNOME file-copy format only.
  uri="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$filepath")"
  printf 'copy\n%s\n' "$uri" | wl-copy --type x-special/gnome-copied-files
fi

printf '%s\n' "$filepath"
omarchy-notification-send "Screenshot copied" "Click to edit, or paste to attach it." \
  --image "$filepath" \
  --exec "$(printf '%q %q' "${OMARCHY_SCREENSHOT_EDITOR:-tensaku-edit}" "$filepath")" -t 3000