#!/usr/bin/env bash
set -euo pipefail

# Apply Omarchy's internal-display toggle to the laptop's current lid state.
STARTUP_WAIT_ATTEMPTS="${LID_MONITOR_MODE_WAIT_ATTEMPTS:-20}"
STARTUP_WAIT_SECONDS="${LID_MONITOR_MODE_WAIT_SECONDS:-0.5}"
state="${1:-startup}"

close_lid() {
  if omarchy-hw-external-monitors; then
    omarchy-hyprland-monitor-internal off
  fi
}

open_lid() {
  omarchy-hyprland-monitor-internal on
}

lid_state_from_proc() {
  local state_file lid_state

  for state_file in /proc/acpi/button/lid/*/state; do
    [ -e "$state_file" ] || continue
    lid_state="$(awk '{print $NF}' "$state_file" 2>/dev/null || true)"
    case "$lid_state" in
      open|closed) printf '%s\n' "$lid_state"; return 0 ;;
    esac
  done
  return 1
}

lid_state_from_evdev() {
  command -v python3 >/dev/null 2>&1 || return 1

  python3 - <<'PY'
import array
import fcntl
import glob
import os
import sys

IOC_READ = 2
EVIOCGSW_NR = 0x1B
EVIOCGSW_TYPE = ord("E")


def eviocgsw(length):
    return (IOC_READ << 30) | (length << 16) | (EVIOCGSW_TYPE << 8) | EVIOCGSW_NR


for namefile in glob.glob("/sys/class/input/input*/name"):
    try:
        if open(namefile, encoding="utf-8").read().strip() != "Lid Switch":
            continue

        for event_dir in glob.glob(os.path.join(os.path.dirname(namefile), "event*")):
            uevent = open(os.path.join(event_dir, "uevent"), encoding="utf-8").read()
            devname = next(line.split("=", 1)[1] for line in uevent.splitlines() if line.startswith("DEVNAME="))
            fd = os.open(os.path.join("/dev", devname), os.O_RDONLY | os.O_NONBLOCK)
            try:
                switches = array.array("B", [0] * 8)
                fcntl.ioctl(fd, eviocgsw(len(switches)), switches, True)
            finally:
                os.close(fd)
            print("closed" if switches[0] & 1 else "open")
            sys.exit(0)
    except (OSError, StopIteration):
        continue

sys.exit(1)
PY
}

lid_state() {
  lid_state_from_proc || lid_state_from_evdev
}

startup_lid() {
  local current i

  for ((i = 1; i <= STARTUP_WAIT_ATTEMPTS; i++)); do
    hyprctl monitors all >/dev/null 2>&1 && break
    sleep "$STARTUP_WAIT_SECONDS"
  done

  current="$(lid_state || true)"
  case "$current" in
    closed)
      # USB-C displays can appear shortly after Hyprland starts.
      for ((i = 1; i <= STARTUP_WAIT_ATTEMPTS; i++)); do
        if omarchy-hw-external-monitors; then
          close_lid
          return
        fi
        sleep "$STARTUP_WAIT_SECONDS"
      done
      ;;
    open) ;;
    *) printf 'Could not determine lid state\n' >&2; return 1 ;;
  esac
}

case "$state" in
  close|closed|off) close_lid ;;
  open|opened|on) open_lid ;;
  startup|auto) startup_lid ;;
  *) printf 'Usage: %s {close|open|startup}\n' "$0" >&2; exit 2 ;;
esac
