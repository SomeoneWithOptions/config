{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 600
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "andres.clock",
    "layout": {
      "left": [
        { "id": "andres.workspaces" }
      ],
      "center": [],
      "right": [
        { "id": "andres.pill" },
        { "id": "andres.tray" },
        { "id": "omarchy.system-update" },
        { "id": "andres.pill" },
        { "id": "andres.bluetooth" },
        { "id": "andres.network" },
        { "id": "andres.audio" },
        { "id": "andres.monitor" },
        { "id": "andres.power" },
        { "id": "andres.pill" },
        {
          "id": "andres.clock",
          "format": "ddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy"
        },
        { "id": "omarchy.spacer", "size": 16 }
      ]
    }
  },
  "plugins": [
    { "id": "andres.desktop-frame" },
    { "id": "andres.idle" },
    { "id": "andres.menu" },
    { "id": "andres.notifications" }
  ],
  "disabledPlugins": [
    "omarchy.idle",
    "omarchy.menu",
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "andres.idle",
    "andres.menu",
    "andres.notifications"
  ]
}
