#!/usr/bin/env bash
set -euo pipefail

# Take an Omarchy screenshot, then put the saved PNG on the clipboard as a file
# object, matching the practical behavior of copying an image from GNOME Files.

mode="${1:-smart}"
case "$mode" in
  smart|region|windows|fullscreen)
    shift || true
    ;;
  *)
    mode="smart"
    ;;
esac

editor="${OMARCHY_SCREENSHOT_EDITOR:-omasnap}"
for arg in "$@"; do
  if [[ "$arg" == --editor=* ]]; then
    editor="${arg#--editor=}"
  fi
done

capture_path="$PATH"
if command -v quickshell >/dev/null 2>&1 \
  && [[ -x "$HOME/.local/lib/flicko-picker/slurp" ]] \
  && [[ -f "$HOME/.config/quickshell/flicko-picker/shell.qml" ]]; then
  capture_path="$HOME/.local/lib/flicko-picker:$capture_path"
fi

# The Omarchy screenshot command now delegates to Omasnap: it bypasses slurp
# and --save no longer prints a path. Keep Flicko by picking geometry directly.
freeze_pid=""
cleanup() {
  if [[ -n "$freeze_pid" ]]; then
    kill "$freeze_pid" 2>/dev/null || true
    freeze_pid=""
  fi
}
trap cleanup EXIT

{ read -r freeze_pid; read -r selection; } < <(PATH="$capture_path" omarchy-capture-region "$mode" --keep-freeze) || true
[[ -n "${selection:-}" ]] || exit 0

output_dir="${OMARCHY_SCREENSHOT_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$output_dir"
filepath="$(mktemp "$output_dir/screenshot-$(date +'%Y-%m-%d_%H-%M-%S')-XXXXXX.png")"
if ! grim -g "$selection" "$filepath"; then
  rm -f "$filepath"
  exit 1
fi
cleanup

# Always publish image bytes first. They remain available if the richer
# file/image helper is missing or fails to start.
wl-copy --type image/png <"$filepath"

clipboard_helper="$HOME/.local/bin/copy-file-to-clipboard"
if [[ -x "$clipboard_helper" ]]; then
  setsid -f "$clipboard_helper" "$filepath" >/dev/null 2>&1
fi

printf '%s\n' "$filepath"
omarchy-notification-send "Screenshot copied" "Click to edit, or paste to attach it." \
  --image "$filepath" -t 3000 \
  --exec "$editor" "$filepath" || true
