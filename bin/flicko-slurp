#!/usr/bin/env bash
set -uo pipefail

picker_dir=${FLICKO_PICKER_DIR:-$HOME/.config/quickshell/flicko-picker}
runtime=${XDG_RUNTIME_DIR:-/tmp}
pidfile="$runtime/flicko-picker.pid"
output=$(mktemp "$runtime/flicko-picker.XXXXXX")
log="$runtime/flicko-picker.log"
pid=

cleanup() {
  [[ -n ${pid:-} ]] && kill "$pid" 2>/dev/null || true
  if [[ -r $pidfile ]] && [[ $(<"$pidfile") == "${pid:-}" ]]; then
    rm -f "$pidfile"
  fi
  rm -f "$output"
}
trap cleanup EXIT INT TERM

if [[ -r $pidfile ]]; then
  old_pid=$(<"$pidfile")
  if [[ $old_pid =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
    kill "$old_pid" 2>/dev/null || true
    exit 0
  fi
  rm -f "$pidfile"
fi

theme_file="$HOME/.config/omarchy/current/theme/colors.toml"
[[ -f $theme_file ]] || theme_file="$HOME/.local/state/omarchy/current/theme/colors.toml"

read_color() {
  awk -F= -v key="$1" '
    $1 ~ "^[[:space:]]*" key "[[:space:]]*$" {
      gsub(/[[:space:]\"\047]/, "", $2); print $2; exit
    }
  ' "$theme_file" 2>/dev/null
}

export FLICKO_OUTPUT="$output"
export FLICKO_BACKGROUND="$(read_color background)"
export FLICKO_SCREEN="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused).name' | head -1)"
export QS_NO_RELOAD_POPUP=1
[[ ${1:-} == --self-test ]] && export FLICKO_TEST=1

quickshell --no-color --path "$picker_dir" >"$log" 2>&1 &
pid=$!
printf '%s\n' "$pid" >"$pidfile"
wait "$pid" || true
pid=
rm -f "$pidfile"

# Allow compositor frame pass to complete unmapping flicko-picker overlay
sleep 0.05

result=$(<"$output")
if [[ ${FLICKO_TEST:-0} == 1 ]]; then
  [[ $result == "10,20 300x200" ]] || {
    printf 'self-test failed; see %s\n' "$log" >&2
    exit 1
  }
  echo "self-test passed"
else
  printf '%s\n' "$result"
fi
