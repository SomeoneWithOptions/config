#!/usr/bin/env bash
set -euo pipefail

config_dir=${DESKTOP_FRAME_CONFIG:-$HOME/.config/quickshell/desktop-frame}
hypr_config=${DESKTOP_FRAME_HYPR_CONFIG:-$HOME/.config/hypr/desktop-frame.conf}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy
state_flag=$state_dir/desktop-frame-off
dnd_flag=$state_dir/notifications-silenced
waybar_flag=$state_dir/toggles/waybar-off
log=$state_dir/desktop-frame.log

write_geometry() {
  local gaps=$1 rounding=$2 tmp
  mkdir -p "$(dirname "$hypr_config")"
  tmp=$(mktemp)
  cat >"$tmp" <<EOF
# Managed by \`omarchy-frame on|off\`.
general {
    gaps_out = $gaps
}

decoration {
    rounding = $rounding
}
EOF
  if [[ ! -f $hypr_config ]] || ! cmp -s "$tmp" "$hypr_config"; then
    cp "$tmp" "$hypr_config"
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null
  fi
  rm -f "$tmp"
}

# Omarchy only autostarts Waybar when this toggle flag is absent
# (default/hypr/autostart.conf). The Quickshell top bar replaces Waybar, so the
# flag has to follow the frame state instead of being set by hand -- otherwise a
# freshly installed machine boots with both bars stacked on top of each other.
sync_waybar() {
  if is_off; then
    rm -f "$waybar_flag"
    return
  fi
  mkdir -p "$(dirname "$waybar_flag")"
  touch "$waybar_flag"
}

stop_waybar() {
  pkill -x waybar >/dev/null 2>&1 || true
}

start_waybar() {
  pgrep -x waybar >/dev/null 2>&1 && return 0
  command -v omarchy-restart-waybar >/dev/null 2>&1 && omarchy-restart-waybar
  return 0
}

quattro_installed() {
  case ${OMARCHY_QUATTRO:-auto} in
    1) return 0 ;;
    0) return 1 ;;
    *) [[ -f /usr/share/omarchy/shell/shell.qml ]] ;;
  esac
}

# Only one process can own org.freedesktop.Notifications. Mako wins the login
# race (Omarchy autostarts it first), so hand the bus name over before starting.
stop_mako() {
  systemctl --user stop mako.service >/dev/null 2>&1 || true
  pkill -x mako >/dev/null 2>&1 || true
  for _ in {1..20}; do
    pgrep -x mako >/dev/null 2>&1 || return 0
    sleep 0.05
  done
}

start_mako() {
  pgrep -x mako >/dev/null 2>&1 && return 0
  systemctl --user start mako.service >/dev/null 2>&1 || true
}

start_shell() {
  [[ -d $config_dir ]] || return 1
  mkdir -p "$state_dir"
  [[ -f $dnd_flag ]] || printf '0\n' >"$dnd_flag"
  stop_mako
  QS_NO_RELOAD_POPUP=1 quickshell --no-color --no-duplicate --daemonize --path "$config_dir" >>"$log" 2>&1 || true
}

stop_shell() {
  quickshell kill --path "$config_dir" >/dev/null 2>&1 || true
  for _ in {1..20}; do
    quickshell list --path "$config_dir" 2>/dev/null | grep -q '^Instance ' || return 0
    sleep 0.05
  done
}

is_off() {
  [[ -e $state_flag ]]
}

case ${1:-status} in
  configure)
    quattro_installed && exit 0
    mkdir -p "$state_dir"
    sync_waybar
    if is_off; then write_geometry 10 8; else write_geometry 0 18; fi
    ;;
  start)
    # Quattro starts one package-owned shell and loads this frame as a plugin.
    quattro_installed && exit 0
    mkdir -p "$state_dir"
    sync_waybar
    if is_off; then
      write_geometry 10 8
    else
      write_geometry 0 18
      # Waybar's autostart and this one are both exec-once, so the flag alone
      # does not settle the race on a machine that had Waybar running.
      stop_waybar
      start_shell
    fi
    ;;
  on)
    if quattro_installed; then
      omarchy plugin enable andres.desktop-frame
      printf 'Desktop frame enabled.\n'
      exit 0
    fi
    mkdir -p "$state_dir"
    rm -f "$state_flag"
    sync_waybar
    stop_waybar
    write_geometry 0 18
    start_shell
    printf 'Desktop frame enabled.\n'
    ;;
  off|restore)
    if quattro_installed; then
      omarchy plugin disable andres.desktop-frame
      printf 'Desktop frame disabled. Re-enable: omarchy-frame on\n'
      exit 0
    fi
    mkdir -p "$state_dir"
    touch "$state_flag"
    sync_waybar
    stop_shell
    start_mako
    start_waybar
    write_geometry 10 8
    printf 'Original desktop restored. Re-enable: omarchy-frame on\n'
    ;;
  restart)
    if quattro_installed; then
      exec omarchy restart shell
    fi
    stop_shell
    is_off || { write_geometry 0 18; start_shell; }
    ;;
  launcher)
    if quattro_installed; then
      exec omarchy-shell shell toggle andres.desktop-frame '{}'
    elif is_off; then
      exec omarchy-launch-walker
    else
      start_shell
      for _ in {1..10}; do
        if quickshell ipc --path "$config_dir" call desktopFrame toggle >/dev/null 2>&1; then exit 0; fi
        sleep 0.05
      done
      exec omarchy-launch-walker
    fi
    ;;
  notify)
    # Routes legacy callers to Quattro's native notification service.
    action=${2:-}
    if quattro_installed; then
      case $action in
        dismiss) exec omarchy-shell notifications dismissOne ;;
        dismiss-all) exec omarchy-shell notifications dismissAll ;;
        invoke) exec omarchy-shell notifications invokeLast ;;
        dnd) exec omarchy-toggle-notification-silencing ;;
        *) printf 'Usage: omarchy-frame notify {dismiss|dismiss-all|invoke|dnd}\n' >&2; exit 2 ;;
      esac
    fi
    if is_off; then
      case $action in
        dismiss) makoctl dismiss ;;
        dismiss-all) makoctl dismiss --all ;;
        invoke) makoctl invoke ;;
        dnd) exec omarchy-toggle-notification-silencing ;;
        *) printf 'Usage: omarchy-frame notify {dismiss|dismiss-all|invoke|dnd}\n' >&2; exit 2 ;;
      esac
      exit 0
    fi
    mkdir -p "$state_dir"
    case $action in
      dismiss) quickshell ipc --path "$config_dir" call notifications dismiss >/dev/null 2>&1 || true ;;
      dismiss-all) quickshell ipc --path "$config_dir" call notifications dismissAll >/dev/null 2>&1 || true ;;
      invoke) quickshell ipc --path "$config_dir" call notifications invoke >/dev/null 2>&1 || true ;;
      dnd)
        if [[ $(cat "$dnd_flag" 2>/dev/null) == 1 ]]; then
          printf '0\n' >"$dnd_flag"
          notify-send -u low "󰂚    Enabled notifications"
        else
          printf '1\n' >"$dnd_flag"
          notify-send -u low "󰂛    Silenced notifications"
        fi
        pkill -RTMIN+10 waybar >/dev/null 2>&1 || true
        ;;
      *) printf 'Usage: omarchy-frame notify {dismiss|dismiss-all|invoke|dnd}\n' >&2; exit 2 ;;
    esac
    ;;
  status)
    if is_off; then printf 'off (original desktop)\n'; else printf 'on\n'; fi
    ;;
  *)
    printf 'Usage: omarchy-frame {on|off|restart|launcher|notify|status}\n' >&2
    exit 2
    ;;
esac
