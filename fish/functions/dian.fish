function dian --wraps='env LANG=es_CO.UTF-8 LC_ALL=es_CO.UTF-8 chromium --lang=es-CO --user-data-dir=/tmp/dian-chromium --disable-extensions' --description 'alias dian env LANG=es_CO.UTF-8 LC_ALL=es_CO.UTF-8 chromium --lang=es-CO --user-data-dir=/tmp/dian-chromium --disable-extensions'
    env LANG=es_CO.UTF-8 LC_ALL=es_CO.UTF-8 chromium --lang=es-CO --user-data-dir=/tmp/dian-chromium --disable-extensions $argv
end
