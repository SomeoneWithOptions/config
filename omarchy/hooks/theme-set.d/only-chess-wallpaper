#!/bin/bash
set -euo pipefail
THEME_NAME="${1:-}"
[[ "$THEME_NAME" == "catppuccin" ]] || exit 0
SRC="/.config/omarchy/backgrounds/chess.jpg"
DEST_DIR="$HOME/.config/omarchy/current/theme/backgrounds"
[[ -f "$SRC" ]] || exit 0
mkdir -p "$DEST_DIR"
find "$DEST_DIR" -maxdepth 1 -type f -delete
cp "$SRC" "$DEST_DIR/chess.jpg"
ln -nsf "$DEST_DIR/chess.jpg" "$HOME/.config/omarchy/current/background"
pkill -x swaybg 2>/dev/null || true
setsid uwsm-app -- swaybg -i "$HOME/.config/omarchy/current/background" -m fill >/dev/null 2>&1 &
