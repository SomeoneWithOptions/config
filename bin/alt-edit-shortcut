#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"

window_class="$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""' 2>/dev/null || true)"

case "$window_class" in
  Alacritty|org.alacritty.Alacritty|org.omarchy.*|foot|footclient|kitty|com.mitchellh.ghostty|com.mitchellh.ghostty.*)
    terminal=1
    ;;
  *)
    terminal=0
    ;;
esac

case "$action:$terminal" in
  copy:1)  mods="CTRL SHIFT"; key=C ;;
  paste:1) mods="CTRL SHIFT"; key=V ;;
  copy:0)  mods=CTRL;         key=C ;;
  paste:0) mods=CTRL;         key=V ;;
  *)
    echo "Usage: alt-edit-shortcut copy|paste" >&2
    exit 64
    ;;
esac

hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"down\" })"
sleep 0.05
hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"up\" })"
