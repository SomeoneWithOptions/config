#!/bin/bash

# Keep Omarchy's current multi-monitor launcher, replacing only its animation.
launcher=/usr/share/omarchy/bin/omarchy-launch-screensaver
if ! grep -q -- '-e omarchy-screensaver' "$launcher"; then
  notify-send -u critical "Matrix screensaver needs updating"
  exit 1
fi
exec bash <(sed "s|-e omarchy-screensaver|-e $HOME/.local/bin/matrix-screensaver|g" "$launcher") "$@"
