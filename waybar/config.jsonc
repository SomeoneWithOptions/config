{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": -7,
  "spacing": 0,
  "height": 28,
  "modules-left": [],
  "modules-center": [],
  "modules-right": [
    "group/apps",
    "group/system",
    "group/time"
  ],
  "group/apps": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "custom/update"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces",
      "custom/voxtype",
      "custom/screenrecording-indicator",
      "custom/idle-indicator",
      "custom/notification-silencing-indicator",
      "bluetooth",
      "network",
      "pulseaudio",
      "custom/battery-profile"
    ]
  },
  "group/time": {
    "orientation": "horizontal",
    "modules": [
      "clock"
    ]
  },
  "hyprland/workspaces": {
    "active-only": true,
    "format": "{name}",
    "on-click": "activate"
  },
  "custom/omarchy": {
    "format": "<span font='Material Symbols Rounded 12 @FILL=1'>widgets</span>",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
  },
  "custom/update": {
    "exec": "omarchy-update-available",
    "format": "<span font='Material Symbols Rounded 12 @FILL=1'>system_update_alt</span>",
    "interval": 21600,
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "signal": 7,
    "tooltip-format": "Omarchy update available"
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "format": "{icon}",
    "format-icons": {
      "idle": "<span font='Material Symbols Rounded 12 @FILL=1'>mic</span>",
      "recording": "<span font='Material Symbols Rounded 12 @FILL=1'>graphic_eq</span>",
      "transcribing": "<span font='Material Symbols Rounded 12 @FILL=1'>speech_to_text</span>"
    },
    "on-click": "omarchy-voxtype-model",
    "on-click-right": "omarchy-voxtype-config",
    "return-type": "json",
    "tooltip": true
  },
  "custom/screenrecording-indicator": {
    "exec": "~/.config/waybar/scripts/screen-recording.sh",
    "on-click": "omarchy-capture-screenrecording",
    "return-type": "json",
    "signal": 8
  },
  "custom/idle-indicator": {
    "exec": "~/.config/waybar/scripts/idle.sh",
    "on-click": "omarchy-toggle-idle",
    "return-type": "json",
    "signal": 9
  },
  "custom/notification-silencing-indicator": {
    "exec": "~/.config/waybar/scripts/notification-silencing.sh",
    "on-click": "omarchy-toggle-notification-silencing",
    "return-type": "json",
    "signal": 10
  },
  "bluetooth": {
    "format": "<span font='Material Symbols Rounded 12 @FILL=1'>bluetooth</span>",
    "format-connected": "<span font='Material Symbols Rounded 12 @FILL=1'>bluetooth_connected</span>",
    "format-disabled": "<span font='Material Symbols Rounded 12 @FILL=1'>bluetooth_disabled</span>",
    "format-no-controller": "",
    "format-off": "<span font='Material Symbols Rounded 12 @FILL=1'>bluetooth_disabled</span>",
    "on-click": "omarchy-launch-bluetooth",
    "tooltip-format": "Devices connected: {num_connections}"
  },
  "network": {
    "format": "{icon}",
    "format-disconnected": "<span font='Material Symbols Rounded 12 @FILL=1'>wifi_off</span>",
    "format-ethernet": "<span font='Material Symbols Rounded 12 @FILL=1'>lan</span>",
    "format-icons": [
      "<span font='Material Symbols Rounded 12 @FILL=1'>wifi_1_bar</span>",
      "<span font='Material Symbols Rounded 12 @FILL=1'>wifi_1_bar</span>",
      "<span font='Material Symbols Rounded 12 @FILL=1'>wifi_2_bar</span>",
      "<span font='Material Symbols Rounded 12 @FILL=1'>wifi_3_bar</span>",
      "<span font='Material Symbols Rounded 12 @FILL=1'>wifi</span>"
    ],
    "format-wifi": "{icon}",
    "interval": 3,
    "on-click": "omarchy-launch-wifi",
    "spacing": 1,
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-icons": {
      "default": [
        "<span font='Material Symbols Rounded 12 @FILL=1'>volume_mute</span>",
        "<span font='Material Symbols Rounded 12 @FILL=1'>volume_down</span>",
        "<span font='Material Symbols Rounded 12 @FILL=1'>volume_up</span>"
      ],
      "headphone": "<span font='Material Symbols Rounded 12 @FILL=1'>headphones</span>",
      "headset": "<span font='Material Symbols Rounded 12 @FILL=1'>headset</span>"
    },
    "format-muted": "<span font='Material Symbols Rounded 12 @FILL=1'>volume_off</span>",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t",
    "scroll-step": 5,
    "tooltip-format": "Playing at {volume}%"
  },
  "custom/battery-profile": {
    "exec": "~/.config/waybar/scripts/battery-power-profile.sh",
    "format": "{}",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
    "return-type": "json",
    "tooltip": true
  },
  "clock": {
    "format": "{:L%a %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select",
    "tooltip": false
  },
  "custom/weather": {
    "exec": "$OMARCHY_PATH/default/waybar/weather.sh",
    "interval": 60,
    "on-click": "notify-send -u low \"$(omarchy-weather-status)\"",
    "return-type": "json",
    "tooltip": false
  },
  "tray": {
    "icon-size": 13,
    "spacing": 12
  }
}
