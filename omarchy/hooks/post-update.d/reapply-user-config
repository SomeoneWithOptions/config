#!/bin/bash

# `omarchy update` runs `omarchy-migrate`, and migrations edit ~/.config in place
# (`sed -i` on hypr/looknfeel.conf, hypr/bindings.conf, waybar/config.jsonc,
# waybar/style.css; a plain `cp` over hypr/hypridle.conf and fontconfig/fonts.conf).
# The user layer is not sacred to them, so customizations silently revert.
#
# This hook runs after migrations and before `omarchy-update-restart`, so
# reapplying the repo -- the source of truth -- puts everything back and the
# restart at the end of the update picks it up.

set -euo pipefail

CONFIG_REPO="${CONFIG_REPO:-$HOME/code/config}"

# Silence here means customizations quietly revert on every future update, so make
# a missing checkout visible rather than exiting 0 into the update's scrollback.
if [[ ! -x "$CONFIG_REPO/4 ConfigFiles.sh" ]]; then
  echo "Config repo not found at $CONFIG_REPO; user config was NOT reapplied"
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -u critical "Omarchy update" "No config repo at $CONFIG_REPO; customizations not reapplied"
  exit 1
fi

echo "Reapplying user config from $CONFIG_REPO..."
exec "$CONFIG_REPO/4 ConfigFiles.sh"
