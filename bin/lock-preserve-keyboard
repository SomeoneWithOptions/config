#!/bin/bash
set -euo pipefail

device="tpacpi::kbd_backlight"
state_file="$HOME/.local/state/keyboard-backlight"

# Only the first lock request owns the real pre-lock brightness. Duplicate
# requests arrive after hyprlock starts, when Omarchy may already have set 0.
if ! pidof hyprlock >/dev/null; then
  brightnessctl -d "$device" get >"$state_file"
fi

# LOCK_ONLY skips Omarchy's dpms-off-after-3s; hypridle blanks screen at 5min instead
OMARCHY_LOCK_ONLY=true omarchy-system-lock

# Omarchy restores its temporary brightnessctl state first. Apply the original
# ThinkPad level last, once hyprlock has exited.
(
  sleep 1
  while pidof hyprlock >/dev/null; do
    sleep 1
  done
  brightnessctl -d "$device" set "$(<"$state_file")" >/dev/null
) &
